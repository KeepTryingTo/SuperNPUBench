#!/bin/bash
# Multi-thread GMMA FlashAttention precision variants.

# No set -e: HIF4_VECBF16 and some modes fail to compile (shared fp4+shared fp4
# not accepted by matrix_input_pair_legal); the script must continue to compile
# subsequent shape groups (fixpipe, long-context).
: "${COMPILER_DIR:?Set COMPILER_DIR to the Linx compiler bin directory}"

# === SharedTile capacity gate (issue #192) ===
# gfsim runs a 256 KiB shareTReg pool. Full-pool footprints deadlock with the
# software pipeline's generational overlap (next-generation TLOAD issued
# before the previous generation's last consumer). Gate every testcase at
# Q+K+V data-tile bytes <= 128 KiB (half pool, overlap headroom):
#   Q = 128 x (QD/packed) x elem   (SharedMatrixLeft, kTileRows=128)
#   K = Tk  x (QD/packed) x elem   (SharedMatrixRight)
#   V = (Tk/packed) x VD x elem    (SharedMatrixRight)
# MX E8M0 scale tiles are excluded from the criterion (small, and the issue's
# failing cases are FP32). MXFP4/HIF4 pack two elements per stored byte.
GATE_KIB=128

fa_mode_bytes() {
    # $1 = FA_MODE, $2 = Tk, $3 = QD, $4 = VD
    # -> prints Q+K+V bytes
    local elem packed
    case "$1" in
        FP32_*)   elem=4; packed=1 ;;
        BF16_*)   elem=2; packed=1 ;;
        MXFP8_*|FP8_*|HIF8_*) elem=1; packed=1 ;;
        MXFP4_*|HIF4_*) elem=1; packed=2 ;;
        *) echo "unsupported mode: $1" >&2; echo 0; return ;;
    esac
    local tk=$2 qd=$3 vd=$4
    local q=$(( 128 * (qd / packed) * elem ))
    local k=$(( tk * (qd / packed) * elem ))
    local v=$(( (tk / packed) * vd * elem ))
    echo $(( q + k + v ))
}

fa_gate_ok() {
    # $1 = FA_MODE, $2 = Tk, $3 = QD, $4 = VD -> exit 0 = build allowed
    local bytes; bytes=$(fa_mode_bytes "$1" "$2" "${3:-128}" "${4:-128}")
    if (( bytes > GATE_KIB * 1024 )); then
        echo "SKIP capacity: $1 Tk=$2 Q+K+V=$((bytes / 1024))KiB > ${GATE_KIB}KiB"
        return 1
    fi
    return 0
}

# fa_gmma_dynamic uses runtime Q/KV loop bounds with single-pass online
# softmax; Q, score, row state, and PV accumulation remain in tile registers.

# fa_gmma_kchains runs the SAME shape/mode matrix as fa_2d_unroll_gmma.
# It uses the full Tk PV reduction dimension; the chain is carried across KV
# blocks through the CUBE internal accumulator. X_dim/Y_dim are name-only for
# kchains because the kernel does not stage multiple shared tiles.

# fa_lowp: MXFP4 Q/K/V, BF16 QK+softmax, then MXFP4 P/V matmul.
# (Also Sq256/Skv256 — kept as the sole config of its kernel.)
if fa_gate_ok MXFP4_VECBF16 128; then
make diss TESTCASE=fa_lowp \
    COMPILER_DIR="$COMPILER_DIR" \
    FA_MODE=MXFP4_VECBF16 Sq=256 Skv=256 Tm=128 Tk=128 \
    X_dim=1 Y_dim=2
fi

# fa_lowp_recip: TRECIP-based reciprocal path (FA_LOWP_RECIP=1), two shapes
# (baseline + long context). Built from its own TU (src/fa_lowp_recip.cpp)
# so it never reuses a fa_lowp.o compiled without the define (make ignores
# -D flag changes).
if fa_gate_ok MXFP4_VECBF16 128; then
make diss TESTCASE=fa_lowp_recip \
    COMPILER_DIR="$COMPILER_DIR" \
    FA_MODE=MXFP4_VECBF16 Sq=256 Skv=256 Tm=128 Tk=128 \
    X_dim=1 Y_dim=2
fi

if fa_gate_ok MXFP4_VECBF16 128; then
make diss TESTCASE=fa_lowp_recip \
    COMPILER_DIR="$COMPILER_DIR" \
    FA_MODE=MXFP4_VECBF16 Sq=128 Skv=8192 Tm=128 Tk=128 \
    X_dim=1 Y_dim=2
fi

# Larger sequence length (Sq=Skv=1024) to exercise deeper Q-block and K/V-block
# loops. Tile extents unchanged from the multi-tile baseline (Tm=128 Tk=128,
# X_dim=1 Y_dim=2); only the outer iteration counts grow.
for testcase in fa_2d_unroll_gmma fa_fixpipe fa_gmma_kchains; do
    for mode in \
        FP32_VECFP32 \
        BF16_VECFP32 \
        MXFP8_VECFP32 \
        HIF8_VECFP32 \
        FP8_VECFP32 \
        FP8_VECBF16 \
        MXFP4_VECBF16 \
        HIF4_VECBF16; do
        fa_gate_ok "$mode" 128 || continue
        make diss TESTCASE="$testcase" \
            COMPILER_DIR="$COMPILER_DIR" \
            FA_MODE="$mode" Sq=1024 Skv=1024 Tm=128 Tk=128 \
            X_dim=1 Y_dim=2
    done
done

# Long context (small Q, large KV): Sq=128 Skv=8192 exercises a deep K/V-block
# loop with a single Q-block (Qb = Sq/kGroupM = 128/128 = 1). Tile extents
# Tm=128 Tk=128, two K/V tiles staged (Y_dim=2), default head dims QD=VD=128.
for testcase in fa_2d_unroll_gmma fa_fixpipe fa_gmma_kchains; do
    for mode in \
        FP32_VECFP32 \
        BF16_VECFP32 \
        MXFP8_VECFP32 \
        HIF8_VECFP32 \
        FP8_VECFP32 \
        FP8_VECBF16 \
        MXFP4_VECBF16 \
        HIF4_VECBF16; do
        fa_gate_ok "$mode" 128 || continue
        make diss TESTCASE="$testcase" \
            COMPILER_DIR="$COMPILER_DIR" \
            FA_MODE="$mode" Sq=128 Skv=8192 Tm=128 Tk=128 \
            X_dim=1 Y_dim=2
    done
done

# Variable Tk (tile-K): Tk=256 halves the K/V-block loop. Y_dim=1 and Skv=512
# keep at least two K/V blocks. The capacity gate drops the modes whose
# Q+K+V exceeds 128 KiB at Tk=256 (FP32/BF16 — issue #192's deadlock class).
for testcase in fa_2d_unroll_gmma fa_fixpipe fa_gmma_kchains; do
    for mode in \
        FP32_VECFP32 \
        BF16_VECFP32 \
        MXFP8_VECFP32 \
        HIF8_VECFP32 \
        FP8_VECFP32 \
        FP8_VECBF16 \
        MXFP4_VECBF16 \
        HIF4_VECBF16; do
        fa_gate_ok "$mode" 256 || continue
        make diss TESTCASE="$testcase" \
            COMPILER_DIR="$COMPILER_DIR" \
            FA_MODE="$mode" Sq=256 Skv=512 Tm=128 Tk=256 \
            X_dim=1 Y_dim=1
    done
done
